# Worker secrets for local `wrangler dev` only. Copy to .dev.vars; never commit .dev.vars.
#
# Non-secret config (FRONTEND_URL, ALLOWED_ORIGINS) lives in wrangler.jsonc `vars`.
# Do not duplicate it here.
#
# For a deploy, push each secret with: wrangler secret put <NAME>

# The one shared admin key. Every API route except /api/v1/health requires it in the
# X-Admin-API-Key header. Rotate it to revoke access everywhere at once.
ADMIN_API_KEY=replace-with-a-long-random-key

# Read-only token for other apps. Sent as "Authorization: Bearer <token>", it opens
# GET /api/v1/summary and nothing else; every other route answers 403. Leave it unset
# and the summary needs the admin key like everything else.
READ_TOKEN=replace-with-a-different-long-random-token

# Optional. This app's write token for live.imnotbot, which sends each todo's reminder
# as an alert and an email. It is the Home Todos value in NOTIFY_WRITE_TOKEN on
# live.imnotbot. With it unset, no reminder is sent and every route works as before.
# LIVE_NOTIFY_URL (the API base) lives in wrangler.jsonc vars.
# LIVE_NOTIFY_TOKEN=replace-with-the-home-todos-notify-token
