# Worker secrets for local `wrangler dev` only. Copy to .dev.vars; never commit .dev.vars.
#
# Non-secret config (FRONTEND_URL, ALLOWED_ORIGINS) lives in wrangler.jsonc `vars`.
# Do not duplicate it here.
#
# For a deploy, push the key with: wrangler secret put ADMIN_API_KEY

# The one shared admin key. Every API route except /api/v1/health requires it in the
# X-Admin-API-Key header. Rotate it to revoke access everywhere at once.
ADMIN_API_KEY=replace-with-a-long-random-key
