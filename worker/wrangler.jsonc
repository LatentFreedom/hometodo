{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hometodo-worker",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-27",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"observability": {
		"enabled": true
	},

	/**
	 * D1. This project owns its own database; nothing is shared with another app.
	 *
	 * Deploy step 1: run `npx wrangler d1 create hometodo-db` and paste the id it
	 * prints into "database_id" below. Leaving the placeholder is safe by design -
	 * `wrangler deploy` refuses it with Cloudflare error 10021 ("binding DB of type
	 * d1 must have a valid database_id"), so a half-wired project cannot ship.
	 * `--dry-run` does NOT catch this, because it skips the API call. Trust a real
	 * deploy, never a dry run.
	 *
	 * Do not add "remote": true here. It forces the vitest pool to open a Cloudflare
	 * remote preview session, and every spec then fails before it runs.
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hometodo-db",
			"database_id": "520ee645-3962-4f58-8fa5-820809e12cb5"
		}
	],

	/**
	 * The site and the API share one hostname: Pages serves the site there, and this
	 * zone route sends only /api/* to the Worker, so the browser never makes a
	 * cross-origin call in production. The route does not create a DNS record; the
	 * hostname resolves once it is attached to the Pages project as a custom domain.
	 *
	 * Self-hosting on a domain you do not have? Delete this whole block, reach the
	 * worker at its workers.dev URL, and set NEXT_PUBLIC_API_URL to that URL.
	 */
	"routes": [
		{
			"pattern": "home.imnotbot.com/api/*",
			"zone_name": "imnotbot.com"
		}
	],

	/**
	 * Deployed values only. Local dev reads worker/.dev.vars, which overrides
	 * FRONTEND_URL and ALLOWED_ORIGINS with their localhost equivalents - so localhost
	 * must never appear here, or CORS rejects the real site.
	 */
	"vars": {
		"FRONTEND_URL": "https://home.imnotbot.com",
		"HOME_TZ": "America/Indiana/Indianapolis",
		"ALLOWED_ORIGINS": "https://home.imnotbot.com,https://hometodo.pages.dev,http://localhost:3000,http://127.0.0.1:3000"
	}
}
